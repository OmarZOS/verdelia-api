# =============================================================================
# Verdelia — environment configuration
# =============================================================================
#
# Copy this file to `.env` and fill in the values for your environment.
# Never commit a populated `.env` — this file is the template only.
#
# Convention:
#   - String values are single-quoted: SQL_HOST='verdelia-db'
#   - Numeric values are unquoted:       SQL_PORT=3306
#   - Secrets are empty in this template and MUST be set per environment:
#     AUTH_SECRET_KEY, API_SECRET_KEY, SQL_ROOT_PASSWORD, etc.
#
# =============================================================================


# =============================================================================
# 1. SQL DATABASE
# =============================================================================
#
# Primary application database. The API, finance server, and silo all use
# this connection. `SQL_SCHEMA` selects the SQLAlchemy dialect + driver;
# pymysql is the pure-Python MySQL driver used in both dev and prod.
#
# SQL_PORT is the container-internal port. The host-published port is set
# in docker-compose.yml (`ports: - "3308:3306"` maps host 3308 → container
# 3306). Inside the compose network, containers reach each other on 3306.
#
# SQL_HOST='verdelia-db'
# SQL_PORT=3306
# SQL_DATABASE='verdelia'
# SQL_USER='dev_user'
# SQL_PASSWORD='dev_password'
# SQL_ROOT_PASSWORD='dev_password'
# SQL_SCHEMA='mysql+pymysql'


# =============================================================================
# 2. AUTH SERVICE
# =============================================================================
#
# Standalone authentication provider. Runs on its own port, holds its own
# database (SQLite by default for dev), and issues JWT access tokens plus
# refresh tokens. The main API validates those tokens with the same secret
# and algorithm.
#
# AUTH_SECRET_KEY and API_SECRET_KEY are separate secrets. Rotating one
# doesn't invalidate tokens issued by the other. The auth provider signs
# with AUTH_SECRET_KEY; downstream services verify with API_SECRET_KEY.
#
# AUTH_ALGORITHM='HS256'
# AUTH_SECRET_KEY=''                        # REQUIRED — set per environment
# API_ALGORITHM='HS256'
# API_SECRET_KEY=''                         # REQUIRED — set per environment
# ACCESS_TOKEN_EXPIRE_MINUTES=30
# REFRESH_TOKEN_EXPIRE_DAYS=7

# Endpoint paths exposed by the auth provider. These are paths, not URLs;
# the full URL is composed from AUTH_SERVER_* below.
#
# AUTH_REGISTRATION_ENDPOINT='/auth/register'
# AUTH_LOGIN_ENDPOINT='/auth/login'
# AUTH_CHANGE_ENDPOINT='/auth/change-password'
# AUTH_DELETE_ENDPOINT='/auth/delete-user'

# Where the auth provider stores its data. SQLite for dev; swap for a
# shared DB (Postgres/MySQL) in production to survive container restarts.
#
# AUTH_DATABASE_URL='sqlite:///../auth_db/auth_db_data.db'

# CORS: comma-separated origins, or "*" to allow any (dev only). Never
# leave "*" in production — the auth endpoints accept credentials.
#
# AUTH_CROSS_ORIGINS_ALLOWED='*'

# Internal service coordinates. Other services reach the auth provider at
# {AUTH_SERVER_PROTOCOLE}://{AUTH_SERVER_NAME}:{AUTH_PORT}.
#
# AUTH_SERVER_PROTOCOLE='http'
# AUTH_SERVER_NAME='verdelia-auth'
# AUTH_PORT=9090

# Seeded admin account. Created on first startup if the users table is
# empty. Change the password before exposing the service to a network.
#
# DEFAULT_ADMIN_USERNAME='verdelia_api'
# DEFAULT_ADMIN_PASSWORD='change-me-before-deploying'


# =============================================================================
# 3. OAUTH PROVIDERS
# =============================================================================
#
# Third-party identity providers. Leave empty to disable the corresponding
# sign-in option. Client secrets MUST be set as environment secrets in
# production, never committed.
#
# GOOGLE_CLIENT_ID=''
# GOOGLE_CLIENT_SECRET=''
# FACEBOOK_CLIENT_ID=''
# FACEBOOK_CLIENT_SECRET=''
# INSTAGRAM_CLIENT_ID=''
# INSTAGRAM_CLIENT_SECRET=''


# =============================================================================
# 4. API SERVICE
# =============================================================================
#
# Main HTTP API. Runs on API_PORT and is the entry point for the mobile
# and web clients.
#
# API_PORT=9000

# Public base URL, when the API is served behind a reverse proxy. Leave
# blank to use the request's own scheme + host. Set this when generating
# absolute URLs in responses (e.g. image links, redirect targets).
#
# BASE_URL='https://verdelia.com/api'


# =============================================================================
# 5. FILE STORAGE SERVICE (FS)
# =============================================================================
#
# Handles uploads and serves stored files. The API proxies uploads to the
# FS service, which writes to a mounted volume.
#
# FS_HOST='verdelia-fs'
# FS_PORT=9099
# FILE_UPLOAD_ENDPOINT='/fs/upload'

# Storage paths inside the FS container. Both must be writable and
# persisted via a volume mount in docker-compose.yml.
#
# FS_BASE_STORAGE='/fs/base'
# FS_CACHE_STORAGE='/fs/cache'

# DigitalOcean Spaces (or any S3-compatible store) credentials. Leave
# empty to keep uploads local to the FS container's filesystem.
#
# DO_API_TOKEN=''


# =============================================================================
# 6. AI / EXTERNAL SERVICES
# =============================================================================
#
# Credentials for external APIs used by workflows (product lookup,
# barcode enrichment, translation suggestions).
#
# OPENAI_API_KEY=''                         # REQUIRED for AI features


# =============================================================================
# 7. MESSAGE QUEUE (RABBITMQ)
# =============================================================================
#
# Used for background jobs (async emails, webhook fanout, AI enrichment).
# VHOST must start with "/" and be created before the service starts.
#
# RABBITMQ_HOST='rabbitmq'
# RABBITMQ_PORT=5672
# RABBITMQ_USER='dev_user'
# RABBITMQ_PASS='dev_pass'
# RABBITMQ_VHOST='/verdelia'


# =============================================================================
# 8. SILO SERVICE
# =============================================================================
#
# Aggregate service that reads across the API, auth, and finance services
# to produce cross-domain views (dashboards, reports). Reaches its peers
# at {SILO_SERVER_PROTOCOLE}://{SILO_SERVER_NAME}:{SILO_SERVER_PORT}.
#
# SILO_SERVER_PROTOCOLE='http'
# SILO_SERVER_NAME='verdelia-silo'
# SILO_SERVER_PORT=9096
# SILO_SERVER_PREFIX='/esilo'


# =============================================================================
# 9. FINANCE SERVICE
# =============================================================================
#
# Manages invoices, payments, deposits, and financial reporting. Reaches
# its own peers the same way the silo does.
#
# FINANCE_SERVER_PROTOCOLE='http'
# FINANCE_SERVER_NAME='verdelia-finance'
# FINANCE_SERVER_PORT=9098
# FINANCE_SERVER_PREFIX='/finance'


# =============================================================================
# 10. MONITORING
# =============================================================================
#
# Prometheus (or similar) scrape endpoint. The port is exposed on the
# internal network only; do not publish it to the host.
#
# MONITOR_PORT=9080